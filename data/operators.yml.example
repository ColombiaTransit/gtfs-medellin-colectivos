# Canonical source of truth for colectivo/alimentador schedules.
#
# The ArcGIS layers give us geometry and stops but NOT headways or
# operating hours. Operator websites give us headways but not
# machine-readable structured data.
#
# CONFIRMED operator/cuenca mapping (two independent site listings, each
# matching the same route codes seen in the ArcGIS 'ruta' field):
#   cuenca 3 ("C3-xxx") -> MDO (Masivo de Occidente), masivodeoccidente.com
#   cuenca 6 ("C6-xxx") -> SAO6 (Sistema Alimentador Oriental), sao6.com.co
# This matches the ArcGIS dataset description ("...operan en las cuencas 3
# y 6") exactly - between MDO and SAO6, both cuencas are now accounted
# for. Sotrames' zone (Itagüí/Envigado/Sabaneta) is NOT cuenca 3 or 6 as
# far as confirmed so far - its routes may be outside this "Rutas
# Alimentadoras" ArcGIS layer entirely (a different program), or use a
# cuenca code not yet seen. Don't add Sotrames' scraped headway data back
# under either cuenca until its own route codes are found and checked
# against ArcGIS the same way MDO and SAO6 were.
#
# STATUS as of the last update:
#   - MDO: 15 "C3-xxx" route codes + names confirmed (own site's tab
#     list). No schedule tables captured yet - day_types empty.
#   - SAO6: 31 "C6-xxx" route codes + names confirmed (own site's route
#     card grid, which also gives a per-route URL like
#     /rutas/santa-rita-estacion-acevedo - worth fetching individually
#     later, each may have its own schedule/frequency info on that page).
#     No schedule tables captured yet either - day_types empty.
#   - Sotrames: three scraped zone tables (Itagüí/Envigado/Sabaneta) still
#     sitting unattached in raw/sotrames_scrape.json - no confirmed route
#     codes to attach them to.
#
# Workflow:
#   1. scripts/fetch_alimentadoras.py  -> raw geometry/stops (automated)
#   2. scripts/inspect_fields.py       -> prints real field names/values
#   3. scripts/scrape_sotrames.py      -> raw frequency text dump, needs
#                                          manual pairing to route names
#      (MDO/SAO6 are JS SPAs - capture their schedule tables/route pages
#      manually, the way the route lists below were captured)
#   4. A human reconciles (2)+(3) into this file. Re-run only when a route
#      or schedule actually changes.
#   5. scripts/build_gtfs.py reads this file + the raw geometry/stops to
#      emit routes.txt/trips.txt/frequencies.txt/etc.

operators:
  mdo:
    agency_name: "Masivo de Occidente"
    agency_url: "https://masivodeoccidente.com"
    zone: "Occidente - confirmed: operates all cuenca-3 'C3-xxx' routes"
  sao6:
    agency_name: "SAO6 - Sistema Alimentador Oriental"
    agency_url: "https://www.sao6.com.co"
    zone: "Oriente - confirmed: operates all cuenca-6 'C6-xxx' routes"
  sotrames:
    agency_name: "Sotrames S.A.S"
    agency_url: "https://www.sotrames.com.co"
    zone: "Itagüí / Envigado / Sabaneta - cuenca NOT yet confirmed, see note above"

# route_id must match the "ruta" field in rutas_alimentadoras.geojson
# exactly (case-sensitive). Names below are each operator's own rider-
# facing name; ArcGIS's "linea" field can word the same route slightly
# differently - double check both list the same 'ruta' code before
# trusting a match on a route not listed here.
#
# Letter suffixes ("A", "B", "M", "RA"...) are confirmed NOT simple
# direction indicators - see MDO's C3-003 family (M/P/RA/RLC/RV all going
# to different named destinations). SAO6 has the same pattern (e.g.
# C6-002 "Versalles - Punto Cero - Estación Hospital" vs C6-002A
# "Versalles - Estación Hospital" - a shorter branch of the same area).

routes:
