# Canonical source of truth for colectivo/alimentador schedules.
#
# The ArcGIS layers give us geometry and stops but NOT headways or
# operating hours. Operator websites give us headways but not
# machine-readable structured data (except Sotrames, partially).
#
# Workflow:
#   1. scripts/fetch_alimentadoras.py  -> raw geometry/stops (automated)
#   2. scripts/scrape_sotrames.py      -> raw frequency text (automated,
#                                          Sotrames only - SAO6/MDO are JS
#                                          SPAs, see NOTES.md)
#   3. A human reconciles (1) route names from the geometry layer's
#      attribute table with (2)/manually-read SAO6 & MDO pages, and fills
#      in this file once. Re-run only when an operator changes schedules.
#   4. scripts/build_gtfs.py reads this file + the raw geometry/stops to
#      emit routes.txt/trips.txt/frequencies.txt/etc.
#
# route_id must match (or be mapped to, see route_id_map below) the route
# identifier field in rutas_alimentadoras.geojson - run fetch_alimentadoras.py
# once and inspect raw/rutas_alimentadoras.geojson's properties to find the
# right field name, then set ROUTE_ID_FIELD in build_gtfs.py accordingly.

operators:
  sotrames:
    agency_name: "Sotrames S.A.S"
    agency_url: "https://www.sotrames.com.co"
    zone: "Sur (Itaguí / Envigado / Sabaneta)"
  sao6:
    agency_name: "SAO6 - Sistema Alimentador Oriental"
    agency_url: "https://www.sao6.com.co"
    zone: "Oriente"
  mdo:
    agency_name: "Masivo de Occidente"
    agency_url: "https://masivodeoccidente.com"
    zone: "Occidente"

# route_id must match the "ruta" field in rutas_alimentadoras.geojson
# exactly (case-sensitive), e.g. "C3-004P". This is a per-DIRECTION
# itinerary id, not a bidirectional line - a route like "C3-004" typically
# has two entries (e.g. "C3-004P" and "C3-004B") for its two directions,
# each needing its own row here. "linea" in the geojson gives the shared,
# bidirectional route name if you want a nicer route_long_name.
# "cuenca" ("3" or "6") is a rough proxy for which operator serves it -
# cuenca 3 has mostly matched Sotrames' zone (Itagüí/Envigado/Sabaneta) in
# spot checks, but confirm per-route rather than assuming from cuenca alone.

routes:
  # EXAMPLE - replace with real reconciled data before running build_gtfs.py
  - route_id: "REPLACE_ME"           # e.g. "C3-004P" - must match 'ruta' exactly
    operator: sotrames
    route_short_name: "1"
    route_long_name: "Itagüí - Envigado"
    day_types:
      laborable:                     # Mon-Fri, GTFS calendar service_id
        first_departure: "04:40:00"
        last_departure: "23:20:00"
        peak_headway_min: 4.5        # "PICO 4 y 5 MINUTOS" -> average
        offpeak_headway_min: 6
        peak_windows:                # used to switch frequencies.txt blocks
          - ["06:00:00", "09:00:00"]
          - ["16:00:00", "19:00:00"]
      sabado:
        first_departure: "05:00:00"
        last_departure: "21:00:00"
        peak_headway_min: 10
        offpeak_headway_min: 15
        peak_windows: []
